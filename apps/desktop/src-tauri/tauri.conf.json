{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ServerDesk",
  "version": "0.2.1",
  "identifier": "com.qsmx.serverdesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && cargo build --release -p serverdesk-mcp && node scripts/stage-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ServerDesk · 服务器管理",
        "width": 1160,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#121923"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/serverdesk-mcp"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/JingFang-i/server-desk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBRDU5N0M2QkVEQjdDREYKUldUZmZOdSt4cGZWU29IYlF0eVQ4UlhzVlhDNFpEVzlNakVJYzVBcDlJR3M1OHBRTjQ0UC9zMEQK"
    }
  }
}
