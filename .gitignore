# Rust / workspace 构建产物
/target

# 前端构建产物与依赖
node_modules/
dist/
.vite/
*.local

# Tauri 生成物（桌面 schema 由构建生成，不入库）
apps/desktop/src-tauri/gen/

# 打包时暂存的 MCP sidecar（由 scripts/stage-sidecar.mjs 复制）
apps/desktop/src-tauri/resources/
apps/desktop/src-tauri/binaries/

# 移动端图标（桌面应用用不到，由 pnpm tauri icon 随时可再生成）
apps/desktop/src-tauri/icons/ios/
apps/desktop/src-tauri/icons/android/

# 本地敏感/运行时文件（双保险，正常不会出现在仓库目录）
*.db
*.db-wal
*.db-shm
*.sdbackup
m1-interim.key
ipc-token
ipc-port

# 环境变量与密钥（防误提交）
.env
.env.*
*.key
*.pem
!docs/**/*.pem.example

# 本地工具缓存（代码索引等）
.codegraph/
.serena/

# 备份与临时文件
.DS_Store
Thumbs.db
*.log
coverage/

# 应用内更新签名密钥（私钥绝不能提交）
.updater-keys/

# pnpm 本地依赖存储（沙箱内全局存储不可写时的回退）
.pnpm-store/

# Developer ID 签名私钥与 CSR
.apple-cert/
